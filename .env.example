# ==========================================
# CHARITYY - Configuration Environnement
# Aucune valeur réelle ou secrète dans ce fichier.
# ==========================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=XOF

# Base de données (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/charityy?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/charityy?schema=public

# Authentification
AUTH_SECRET=changeme_in_production_32_characters_min
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Chiffrement applicatif (Données sensibles / KYC)
# Clé 32 octets (base64) pour AES-256-GCM
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
DATA_ENCRYPTION_KEY_ID=v1
HASH_PEPPER=local_pepper_secret_for_ip_and_device_hashing

# Moneroo (Paiements et reversements)
MONEROO_SECRET_KEY=test_secret_key
MONEROO_WEBHOOK_SECRET=test_webhook_secret
MONEROO_API_BASE=https://api.moneroo.io/v1

# Cloudflare (Stream et R2)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=charityy-evidence-private
R2_BUCKET_PUBLIC=charityy-media-public
R2_ENDPOINT=
STREAM_API_TOKEN=
STREAM_WEBHOOK_SECRET=

# Agora (Lives et audio interactif)
NEXT_PUBLIC_AGORA_APP_ID=test_agora_app_id
AGORA_APP_CERTIFICATE=test_agora_app_cert

# Redis / Rate limiting / Queues
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# Communications
RESEND_API_KEY=
EMAIL_FROM=notifications@charityy.org
SMS_PROVIDER=termii
TERMII_API_KEY=

# Tâches planifiées (Crons)
CRON_SECRET=test_cron_secret_string
